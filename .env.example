# Tandem gateway configuration. Every variable the gateway reads is listed here with its default.
# Consumer: src/config.ts (loaded by src/gateway.ts) unless noted otherwise. compose.yaml passes this
# file to the gateway container with env_file and overrides BIND_HOST, PORT and RUNTIME_NETWORK.

# --- HTTP ---------------------------------------------------------------------------------------
# Listen address. Default 127.0.0.1; compose.yaml sets 0.0.0.0 inside the container.
BIND_HOST=127.0.0.1
# Listen port. Default 8787.
PORT=8787
# Host port compose.yaml publishes on 127.0.0.1. Consumer: compose.yaml only. Default 8787.
GATEWAY_PORT=8787

# --- Authentication (service JWT, `sub` = person id) ---------------------------------------------
# oidc (production) or dev (local HS256 secret). Default oidc.
AUTH_MODE=oidc
# Required when AUTH_MODE=oidc: expected issuer, audience and JWKS URL (RS256/ES256).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Required when AUTH_MODE=dev: HS256 secret, at least 32 characters. Also read by scripts/token.ts
# and scripts/e2e.ts. Tokens use issuer "tandem-dev" and audience "tandem".
DEV_AUTH_SECRET=
# true serves POST /dev/token and the subject field on /connect. Only allowed with AUTH_MODE=dev.
# Default false.
DEV_TOKEN_ROUTE=false

# --- Runtimes ------------------------------------------------------------------------------------
# Required. HMAC key for runtime names (container/volume = HMAC(SERVICE_SECRET, subject)).
# At least 32 characters. Changing it orphans every existing runtime volume.
SERVICE_SECRET=
# Docker Engine endpoint: unix:///path or tcp://host:port (a restricted socket proxy in production).
# Default unix:///var/run/docker.sock.
RUNTIME_DOCKER_HOST=unix:///var/run/docker.sock
# Per-person runtime image (built from ./runtime). Default tandem-runtime:2026.11.6-preview.7.
RUNTIME_IMAGE=tandem-runtime:2026.11.6-preview.7
# Docker network shared only by the gateway and runtimes. Default tandem-runtimes.
RUNTIME_NETWORK=tandem-runtimes
# Platform of runtime containers: empty = the Docker host's own platform, or linux/amd64 /
# linux/arm64 to run that variant of a multi-platform RUNTIME_IMAGE (under emulation if foreign).
# Default empty.
RUNTIME_PLATFORM=
# Prefix of every container, volume and label the gateway creates. Default tandem.
RUNTIME_PREFIX=tandem
# Limits per runtime container. Defaults 2048 MiB, 2 CPUs, 512 processes.
RUNTIME_MEMORY_MB=2048
RUNTIME_CPUS=2
RUNTIME_PIDS=512
# Source address(es) allowed to reach a runtime's bridge port, as CIDR. Default empty: the
# gateway's own address on RUNTIME_NETWORK, detected from its container.
BRIDGE_ALLOW=
# Stop a runtime after this many idle minutes (never while a run, question or sign-in is open).
# Default 5.
IDLE_MINUTES=5
# Happy permission mode for every message: read_only, workspace_write, auto or full_access.
# Default workspace_write (actions the agent asks about become permission questions).
PERMISSION_MODE=workspace_write
# Restart a runtime (when idle) after a successful sign-in so the harnesses load the new account
# and its live model list. Default true.
RESTART_AFTER_SIGN_IN=true
# DEV ONLY (requires AUTH_MODE=dev): "subject=volume[,subject=volume]" mounts an existing volume
# instead of the derived one for that subject. Default empty.
DEV_VOLUME_OVERRIDES=
