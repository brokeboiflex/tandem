# Tandem configuration. Every variable the gateway reads is listed here with its default.
# Consumer: src/config.ts (loaded by src/gateway.ts) unless noted otherwise. compose.yaml passes this
# file to the Tandem container with env_file; the image sets BIND_HOST=0.0.0.0, DATA_DIR and
# RUNTIME_IMAGE_ARCHIVE itself.

# --- HTTP ---------------------------------------------------------------------------------------
# Listen address. Default 127.0.0.1; the image sets 0.0.0.0.
BIND_HOST=0.0.0.0
# Listen port inside the container. Default 8787.
PORT=8787
# Host port compose.yaml publishes on 127.0.0.1 (local use). Consumer: compose.yaml only. Default 8787.
GATEWAY_PORT=8787

# --- Authentication (service JWT, `sub` = person id) ---------------------------------------------
# oidc (production) or dev (local HS256 secret). Default oidc.
AUTH_MODE=oidc
# Required when AUTH_MODE=oidc: expected issuer, audience and JWKS URL (RS256/ES256).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Required when AUTH_MODE=dev: HS256 secret, at least 32 characters. Also read by scripts/token.ts
# and scripts/e2e.ts. Tokens use issuer "tandem-dev" and audience "tandem".
DEV_AUTH_SECRET=
# true serves POST /dev/token and the subject field on /connect. Only allowed with AUTH_MODE=dev.
# Default false.
DEV_TOKEN_ROUTE=false

# --- Runtimes (one microVM per person) -----------------------------------------------------------
# Required. HMAC key for runtime names (microVM and home = HMAC(SERVICE_SECRET, subject)).
# At least 32 characters. Changing it orphans every existing home.
SERVICE_SECRET=
# Size of each person's microVM. Memory is a ceiling, not a reservation: the host gives a microVM
# pages as it touches them and keeps them until it stops (README, Capacity). At least 512.
# Defaults 2048 MiB and 2 vCPUs.
RUNTIME_MEMORY_MB=2048
RUNTIME_CPUS=2
# Stop a runtime after this many idle minutes (never while a run, question or sign-in is open). A
# stopped runtime holds no memory or CPU, only its home on disk. Default 5.
IDLE_MINUTES=5
# Prefix of every microVM name and label of this instance (<prefix>-<id>). Lowercase. Default tandem.
RUNTIME_PREFIX=tandem
# Data volume: microsandbox's state and image cache, every person's home, the MCP sockets. The image
# sets /var/lib/tandem; compose.yaml mounts the `tandem-data` volume there. At most 60 characters.
DATA_DIR=/var/lib/tandem
# The runtime image archive built into the Tandem image, loaded into microsandbox on first start.
# The image sets it; change it only for a custom build. Default /opt/tandem/runtime.tar.
RUNTIME_IMAGE_ARCHIVE=/opt/tandem/runtime.tar
# Instead of the archive: an image already in microsandbox's store (msb pull/load). Default empty.
RUNTIME_IMAGE=
# Happy permission mode for every message: read_only, workspace_write, auto or full_access.
# Default auto: the safest mode in which MCP tools run (Happy refuses every MCP tool in read_only and
# workspace_write). The harness's own reviewer decides routine actions; what it hands off becomes a
# permission question. Never full_access for people's chats.
PERMISSION_MODE=auto
# Restart a runtime (when idle) after a successful sign-in so the harnesses load the new account
# and its live model list. Default true.
RESTART_AFTER_SIGN_IN=true

# --- What runtimes may reach (README, Security) --------------------------------------------------
# allowlist: only the hosts in runtime/egress-allowlist.txt and EGRESS_ALLOW_DOMAINS (ports 80, 443)
# and the EGRESS_ALLOW_RANGES. open: any public address plus those ranges. In both, other people's
# microVMs, the gateway, the host, private networks and cloud metadata stay unreachable.
# Default allowlist.
EGRESS_MODE=allowlist
# Extra hostnames, comma-separated; "*.example.com" covers subdomains (list the apex too).
# Example: registry.npmjs.org,pypi.org,files.pythonhosted.org
EGRESS_ALLOW_DOMAINS=
# IPv4 CIDRs runtimes may reach anyway (TCP, any port), e.g. an internal registry. Default empty.
EGRESS_ALLOW_RANGES=

# --- Application MCP servers (PUT /v1/mcp-servers) -----------------------------------------------
# Origins (scheme://host[:port]) that people's MCP server registrations may point at, comma-separated,
# or * for any. The gateway (not the runtimes) calls them, with people's application credentials.
# Default empty: no MCP server can be registered.
MCP_ALLOWED_ORIGINS=

# --- Compose only -------------------------------------------------------------------------------
# Image tag of the Tandem image. Default tandem:0.2.0.
TANDEM_IMAGE=tandem:0.2.0
