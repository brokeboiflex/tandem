# Tandem gateway configuration. Every variable the gateway reads is listed here with its default.
# Consumer: src/config.ts (loaded by src/gateway.ts) unless noted otherwise. compose.yaml passes this
# file to the gateway container with env_file and overrides BIND_HOST and PORT; it also reads it for
# its own variables (marked "compose").

# --- HTTP ---------------------------------------------------------------------------------------
# Listen address. Default 127.0.0.1; compose.yaml sets 0.0.0.0 inside the container.
BIND_HOST=127.0.0.1
# Listen port. Default 8787.
PORT=8787
# Host port compose.yaml publishes on 127.0.0.1. Consumer: compose.yaml only. Default 8787.
GATEWAY_PORT=8787

# --- Authentication (service JWT, `sub` = person id) ---------------------------------------------
# oidc (production) or dev (local HS256 secret). Default oidc.
AUTH_MODE=oidc
# Required when AUTH_MODE=oidc: expected issuer, audience and JWKS URL (RS256/ES256).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Required when AUTH_MODE=dev: HS256 secret, at least 32 characters. Also read by scripts/token.ts
# and scripts/e2e.ts. Tokens use issuer "tandem-dev" and audience "tandem".
DEV_AUTH_SECRET=
# true serves POST /dev/token and the subject field on /connect. Only allowed with AUTH_MODE=dev.
# Default false.
DEV_TOKEN_ROUTE=false

# --- Runtimes ------------------------------------------------------------------------------------
# Required. HMAC key for runtime names (container/volume = HMAC(SERVICE_SECRET, subject)).
# At least 32 characters. Changing it orphans every existing runtime volume.
SERVICE_SECRET=
# Docker Engine endpoint: unix:///path or tcp://host:port. compose.socket-proxy.yaml sets it to the
# filtered socket. Default unix:///var/run/docker.sock.
RUNTIME_DOCKER_HOST=unix:///var/run/docker.sock
# Per-person runtime image (built from ./runtime), fully qualified so the socket proxy can allowlist
# exactly this image. Default docker.io/library/tandem-runtime:2026.11.6-preview.7.
RUNTIME_IMAGE=docker.io/library/tandem-runtime:2026.11.6-preview.7
# Shared internal network, used only with RUNTIME_NETWORK_ISOLATION=shared or as the fallback when
# Docker has no address pool left for a per-runtime network. Default <RUNTIME_PREFIX>-runtimes.
RUNTIME_NETWORK=
# Platform of runtime containers: empty = the Docker host's own platform, or linux/amd64 /
# linux/arm64 to run that variant of a multi-platform RUNTIME_IMAGE (under emulation if foreign).
# Default empty.
RUNTIME_PLATFORM=
# Prefix of every container, volume, network and label of this instance (also the compose project and
# container names). Several instances on one Engine need different prefixes. Lowercase. Default tandem.
RUNTIME_PREFIX=tandem
# Limits per runtime container; 0 lifts a limit. Defaults 2048 MiB, 2 CPUs, 512 processes.
RUNTIME_MEMORY_MB=2048
RUNTIME_CPUS=2
RUNTIME_PIDS=512
# Only for a gateway running outside Docker (forces the shared network): source address(es) allowed
# to reach a runtime's bridge port, as CIDR. Default empty: the gateway's own address on each
# runtime's network, detected from its container.
BRIDGE_ALLOW=
# Stop a runtime after this many idle minutes (never while a run, question or sign-in is open).
# Default 5.
IDLE_MINUTES=5
# Happy permission mode for every message: read_only, workspace_write, auto or full_access.
# Default auto: the safest mode in which MCP tools run (Happy refuses every MCP tool in read_only and
# workspace_write). The harness's own reviewer decides routine actions; what it hands off becomes a
# permission question. Never full_access for people's chats.
PERMISSION_MODE=auto
# Restart a runtime (when idle) after a successful sign-in so the harnesses load the new account
# and its live model list. Default true.
RESTART_AFTER_SIGN_IN=true

# --- Application MCP servers (PUT /v1/mcp-servers) -----------------------------------------------
# Origins (scheme://host[:port]) that people's MCP server registrations may point at, comma-separated,
# or * for any. The gateway sends people's application credentials there. Default empty: no MCP server
# can be registered.
MCP_ALLOWED_ORIGINS=
# Port of the gateway's internal MCP proxy, which runtimes call. Never publish it. Default 8790.
MCP_PROXY_PORT=8790
# Base URL runtimes use to reach that proxy (it bypasses the egress proxy). Default empty:
# http://<the gateway's address on each runtime's network>:MCP_PROXY_PORT, detected from the gateway's
# container (an address, because gVisor sandboxes cannot resolve names). Set it when the gateway runs
# elsewhere.
MCP_PROXY_URL=

# DEV ONLY (requires AUTH_MODE=dev): "subject=volume[,subject=volume]" mounts an existing volume
# instead of the derived one for that subject. Default empty.
DEV_VOLUME_OVERRIDES=

# --- Hardening (README, Security). Safe defaults; each protection degrades with a startup WARNING
# when the host cannot provide it, and each can be required or relaxed explicitly. ----------------
# 1. OCI runtime for runtimes: auto (gVisor/runsc when the Engine has it, else the Engine default
# with a warning), default (the Engine default, no warning) or a runtime name that must exist
# (runsc, runsc-kvm, kata-runtime ...). Default auto.
RUNTIME_OCI_RUNTIME=auto
# 2. Container lockdown. User (empty = the image's own user). Default 10001:10001.
RUNTIME_USER=10001:10001
# Capabilities added back after dropping ALL, comma-separated. Default empty.
RUNTIME_CAP_ADD=
# Default true.
RUNTIME_NO_NEW_PRIVILEGES=true
# Read-only root filesystem; writable are the person's volume and a noexec /tmp tmpfs. Default true.
RUNTIME_READ_ONLY_ROOTFS=true
# Size of that /tmp tmpfs (0 = none). Default 256.
RUNTIME_TMPFS_MB=256
# 3. Docker API access: auto (warn when it is unfiltered), required (refuse to start unless it is
# filtered, e.g. by compose.socket-proxy.yaml) or none (plain socket on purpose). Default auto.
RUNTIME_DOCKER_PROXY=auto
# 4. Networks: auto (one internal network per runtime; the shared network with a warning when Docker
# has no address pool left), per_runtime (never share) or shared. Default auto.
RUNTIME_NETWORK_ISOLATION=auto
# Egress through the proxy: auto (allowlist, or off with a warning when the proxy is not running),
# allowlist, open (any public host; private addresses stay refused) or off (direct Internet access,
# including the host and LAN). Also read by the egress container (compose). Default auto.
EGRESS_MODE=auto
# Extra hostnames runtimes may reach, comma-separated; "*.example.com" covers subdomains only.
# Consumer: the egress container (compose). Example: registry.npmjs.org,pypi.org,files.pythonhosted.org
EGRESS_ALLOW_DOMAINS=
# Private CIDRs runtimes may reach anyway (e.g. an internal registry). Consumer: the egress container.
EGRESS_ALLOW_RANGES=
# The egress proxy container and port. Default <RUNTIME_PREFIX>-egress:4750.
EGRESS_PROXY=

# --- Compose only -------------------------------------------------------------------------------
# Engine socket on the host. Rootless Docker: $XDG_RUNTIME_DIR/docker.sock. Default /var/run/docker.sock.
DOCKER_SOCKET=/var/run/docker.sock
# compose.socket-proxy.yaml: group of the Engine socket when it is not owned by root
# (stat -c %g /var/run/docker.sock). Default 0.
DOCKER_SOCKET_GID=0
# Image tags of the gateway and the egress proxy. Defaults tandem-gateway:0.1.0, tandem-egress:0.1.0.
GATEWAY_IMAGE=tandem-gateway:0.1.0
EGRESS_IMAGE=tandem-egress:0.1.0
