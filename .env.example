# Tandem configuration. Every variable the gateway reads is listed here with its default.
# Consumer: src/config.ts (loaded by src/gateway.ts) unless noted otherwise. compose.yaml passes this
# file to the Tandem container with env_file; the image sets BIND_HOST=0.0.0.0, DATA_DIR and
# RUNTIME_ROOTFS itself.

# --- HTTP ---------------------------------------------------------------------------------------
# Listen address. Default 127.0.0.1; the image sets 0.0.0.0.
BIND_HOST=0.0.0.0
# Listen port inside the container. Default 8787.
PORT=8787
# Host port compose.yaml publishes on 127.0.0.1 (local use). Consumer: compose.yaml only. Default 8787.
GATEWAY_PORT=8787

# --- Authentication (service JWT, `sub` = person id) ---------------------------------------------
# oidc (production) or dev (local HS256 secret). Default oidc.
AUTH_MODE=oidc
# Required when AUTH_MODE=oidc: expected issuer, audience and JWKS URL (RS256/ES256).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Required when AUTH_MODE=dev: HS256 secret, at least 32 characters. Also read by scripts/token.ts
# and scripts/e2e.ts. Tokens use issuer "tandem-dev" and audience "tandem".
DEV_AUTH_SECRET=
# true serves POST /dev/token and the subject field on /connect. Only allowed with AUTH_MODE=dev.
# Default false.
DEV_TOKEN_ROUTE=false

# --- Sandboxes (one per vendor process, inside the person's cgroup) ------------------------------
# Required. HMAC key for runtime names (sandbox and home = HMAC(SERVICE_SECRET, subject)).
# At least 32 characters. Changing it orphans every existing home.
SERVICE_SECRET=
# Limits per person, for all of their processes together, in their own cgroup: memory in MiB (at
# least 256; reclaim and slowing start at 80 %, and a process tree that exceeds it is ended, only that
# one) and processes (at least 64). CPU is shared equally between people who need it. Without cgroup
# v2 on the host the gateway warns and only the process limit applies. Defaults 1024, 512.
RUNTIME_MEMORY_MB=1024
RUNTIME_PIDS=512
# Stop a person's vendor process after this many idle minutes (never while a run, question or
# sign-in is open; starting one again takes well under a second). Default 2.
IDLE_MINUTES=2
# Prefix of every sandbox name of this instance (<prefix>-<id>). Lowercase. Default tandem.
RUNTIME_PREFIX=tandem
# Data volume: every person's home, their uids, the gateway's sockets. The image sets
# /var/lib/tandem; compose.yaml mounts the `tandem-data` volume there. At most 40 characters.
DATA_DIR=/var/lib/tandem
# The read-only runtime system every sandbox runs on. The image sets it; change it only for a custom
# build. Default /opt/tandem/rootfs.
RUNTIME_ROOTFS=/opt/tandem/rootfs
# Happy permission mode for every message: read_only, workspace_write, auto or full_access.
# Default auto: the safest mode in which MCP tools run (Happy refuses every MCP tool in read_only and
# workspace_write). The harness's own reviewer decides routine actions; what it hands off becomes a
# permission question. Never full_access for people's chats.
PERMISSION_MODE=auto

# --- What runtimes may reach (README, Security) --------------------------------------------------
# Every connection out goes through the gateway's egress proxy (Smokescreen). allowlist: only the
# hosts in runtime/egress-allowlist.txt and EGRESS_ALLOW_DOMAINS. open: any public host. In both,
# private, loopback, link-local and CGNAT addresses are refused unless listed in EGRESS_ALLOW_RANGES.
# Default allowlist.
EGRESS_MODE=allowlist
# Extra hostnames, comma-separated; "*.example.com" covers subdomains only.
# Example: registry.npmjs.org,pypi.org,files.pythonhosted.org
EGRESS_ALLOW_DOMAINS=
# Private IPv4 CIDRs runtimes may reach anyway (e.g. an internal registry). Default empty.
EGRESS_ALLOW_RANGES=

# --- Application MCP servers (PUT /v1/mcp-servers) -----------------------------------------------
# Origins (scheme://host[:port]) that people's MCP server registrations may point at, comma-separated,
# or * for any. The gateway (not the runtimes) calls them, with people's application credentials.
# Default empty: no MCP server can be registered.
MCP_ALLOWED_ORIGINS=

# --- Compose only -------------------------------------------------------------------------------
# Image tag of the Tandem image. Default tandem:0.3.0.
TANDEM_IMAGE=tandem:0.3.0
